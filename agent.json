{
  "$schema": "http://desirecore/schemas/agent.json",
  "version": "1.0.7",
  "name": "合同输入治理官",
  "description": "O1 输入治理闸门。区分合同门禁、范围事实与执行能力状态；受控谈判草稿例外必须同时有明确请求和可审计对象证据。用本地只读结构校验工具验证回执，只向 Lead 交付。",
  "author": "DesireCore",
  "avatar": {
    "char": "闸",
    "color": "purple"
  },
  "llm": {
    "routingMode": "smart",
    "smart": {
      "profile": {
        "tier": "balanced",
        "requiredCapabilities": [
          "tool_use",
          "long_context"
        ],
        "reasoning": "medium"
      }
    },
    "maxRetryDelayMs": 32000
  },
  "capabilities": [
    "contract-intake",
    "contract-review",
    "input-governance",
    "document-completeness-check",
    "attachment-manifest-audit",
    "signature-status-verification",
    "pagination-integrity-check",
    "version-matrix-alignment",
    "legal-document-triage"
  ],
  "trigger_patterns": [
    "合同",
    "协议",
    "合同审查",
    "合同受理",
    "输入治理",
    "准入校验",
    "预检",
    "附件清单",
    "签章",
    "用印",
    "页码",
    "版本矩阵",
    "版本冻结",
    "contract",
    "agreement",
    "contract review",
    "contract intake",
    "input governance",
    "completeness check",
    "attachment manifest",
    "signature status",
    "pagination",
    "version matrix"
  ],
  "accepts_handoff": true,
  "accepts_messages": true,
  "max_concurrent_sessions": 3,
  "command_authority": {
    "enabled": true,
    "allowed_targets": [
      "contract-review-lead",
      "clause-extractor"
    ]
  },
  "default_enabled": {
    "skills": [
      "contract-intake-gate"
    ],
    "tools": []
  },
  "tool_permissions": {
    "allowed": [
      "Read",
      "Ls",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Skill",
      "MathCalc",
      "GenerateUUID",
      "UnderstandImage",
      "AskUserQuestion",
      "Delegate",
      "SendMessage",
      "FileDigest",
      "StructuredFileValidate"
    ],
    "denied": [
      "Bash",
      "PowerShell",
      "TerminalControl",
      "HttpRequest",
      "WebFetch",
      "WebSearch",
      "ComputeCredential",
      "ControlDesireCoreGui",
      "BrowserTakeover",
      "RecallConversation",
      "spawn_agent"
    ]
  },
  "network_security": {
    "enableSsrfProtection": true
  },
  "file_security": {
    "restrictToWorkDirs": true
  },
  "compute_credentials": {
    "allowed_providers": []
  },
  "tools": {
    "ask_user_question": {
      "wait_mode": "always_wait"
    }
  },
  "env": {
    "enabled": true,
    "includeWeekday": true,
    "includeLocalTime": true,
    "includeSessionStart": true,
    "includeOs": false,
    "includeRuntime": false,
    "includeManagedRuntimes": false
  }
}
