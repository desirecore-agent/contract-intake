{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bounded-local-draft7-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intake_id", "case_id", "object", "verdict", "checks", "party_assessments", "freeze", "conclusions", "blocks", "flags", "scope_facts", "capability_status", "serialization_status", "handoff"],
  "definitions": {
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "source_scope", "action"],
      "properties": {
        "id": {"enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8"]},
        "status": {"enum": ["pass", "block", "flag", "n/a", "not_covered"]},
        "source_scope": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_scope", "action"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_scope": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1},
        "search_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "gate_affecting": {"type": "boolean"}
      },
      "oneOf": [
        {"required": ["quote"], "not": {"required": ["search_patterns"]}},
        {"required": ["search_patterns"], "not": {"required": ["quote"]}}
      ]
    },
    "pending": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_scope", "action"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_scope": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "must_escalate": {"type": "boolean"}
      }
    },
    "party_assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["party_id", "party_role", "role_source", "identifier_applicability", "identifier_status", "basis"],
      "properties": {
        "party_id": {"type": "string", "minLength": 1},
        "party_role": {"enum": ["buyer", "seller", "employer", "employee", "provider", "customer", "witness", "guarantor", "other", "unknown"]},
        "role_source": {"type": "string", "minLength": 1},
        "identifier_applicability": {"enum": ["required", "not_applicable", "unknown"]},
        "identifier_status": {"enum": ["present", "missing", "redacted", "unknown"]},
        "basis": {"type": "string", "minLength": 1},
        "identifier_value": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"identifier_status": {"const": "present"}}, "required": ["identifier_status"]}, "then": {"required": ["identifier_value"]}},
        {"if": {"properties": {"identifier_applicability": {"const": "not_applicable"}}, "required": ["identifier_applicability"]}, "then": {"properties": {"identifier_status": {"enum": ["unknown", "redacted"]}}, "not": {"required": ["identifier_value"]}}}
      ]
    },
    "freeze_item": {
      "type": "object", "additionalProperties": false,
      "required": ["frozen", "source_scope", "basis"],
      "properties": {
        "frozen": {"type": "boolean"},
        "source_scope": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "bounded-local-draft7-v1"},
    "intake_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "object": {
      "type": "object", "additionalProperties": false,
      "required": ["object_id", "version", "source_path", "digest_status"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "pattern": "^/"},
        "digest_status": {"enum": ["verified", "frozen_without_digest"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "allOf": [{"if": {"properties": {"digest_status": {"const": "verified"}}}, "then": {"required": ["sha256"]}}]
    },
    "verdict": {"enum": ["passed", "conditional", "blocked"]},
    "party_assessments": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/party_assessment"}},
    "freeze": {
      "type": "object", "additionalProperties": false,
      "required": ["main_version", "attachment_manifest", "pagination", "execution_status"],
      "properties": {
        "main_version": {"$ref": "#/definitions/freeze_item"},
        "attachment_manifest": {"$ref": "#/definitions/freeze_item"},
        "pagination": {"$ref": "#/definitions/freeze_item"},
        "execution_status": {"$ref": "#/definitions/freeze_item"}
      }
    },
    "conclusions": {
      "type": "object", "additionalProperties": false,
      "required": ["consistency_conclusion_allowed", "compliance_conclusion_allowed"],
      "properties": {
        "consistency_conclusion_allowed": {"type": "boolean"},
        "compliance_conclusion_allowed": {"type": "boolean"}
      }
    },
    "checks": {
      "type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/definitions/check"},
      "allOf": [
        {"contains": {"properties": {"id": {"const": "S1"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "S2"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "S3"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "S4"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "S5"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "S6"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "S7"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "S8"}}, "required": ["id"]}}
      ]
    },
    "blocks": {"type": "array", "items": {"$ref": "#/definitions/finding"}},
    "flags": {"type": "array", "items": {"$ref": "#/definitions/finding"}},
    "scope_facts": {"type": "array", "items": {"$ref": "#/definitions/finding"}},
    "capability_status": {"enum": ["ready", "capability_debt"]},
    "serialization_status": {"enum": ["valid", "invalid", "unavailable"]},
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["to", "from", "confirmed", "pending", "scope"],
      "properties": {
        "to": {"type": ["string", "null"]},
        "from": {"const": "contract-intake"},
        "confirmed": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "pending": {"type": "array", "items": {"$ref": "#/definitions/pending"}},
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["in_scope", "out_of_scope"],
          "properties": {
            "in_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"blocks": {"minItems": 1}}, "required": ["blocks"]}, "then": {"properties": {"verdict": {"const": "blocked"}}}},
    {"if": {"properties": {"verdict": {"const": "blocked"}}, "required": ["verdict"]}, "then": {"properties": {"blocks": {"minItems": 1}, "handoff": {"properties": {"to": {"type": "null"}}}}}},
    {"if": {"properties": {"verdict": {"const": "passed"}}, "required": ["verdict"]}, "then": {"properties": {"blocks": {"maxItems": 0}, "flags": {"items": {"properties": {"gate_affecting": {"const": false}}}}}}},
    {"if": {"properties": {"verdict": {"const": "conditional"}}, "required": ["verdict"]}, "then": {"properties": {"blocks": {"maxItems": 0}, "flags": {"contains": {"properties": {"gate_affecting": {"const": true}}, "required": ["gate_affecting"]}}}}},
    {"if": {"properties": {"serialization_status": {"enum": ["invalid", "unavailable"]}}, "required": ["serialization_status"]}, "then": {"properties": {"handoff": {"properties": {"to": {"type": "null"}}}}}},
    {"if": {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "S7"}, "status": {"const": "flag"}}, "required": ["id", "status"]}}}, "required": ["checks"]}, "then": {"properties": {"flags": {"minItems": 1}}, "if": {"properties": {"blocks": {"maxItems": 0}}, "required": ["blocks"]}, "then": {"properties": {"verdict": {"const": "conditional"}}}, "else": {"properties": {"verdict": {"const": "blocked"}}}}},
    {"if": {"properties": {"checks": {"contains": {"type": "object", "properties": {"id": {"const": "S7"}, "status": {"const": "block"}}, "required": ["id", "status"]}}}, "required": ["checks"]}, "then": {"properties": {"blocks": {"minItems": 1}, "verdict": {"const": "blocked"}}}},
    {"if": {"properties": {"freeze": {"properties": {"main_version": {"properties": {"frozen": {"const": false}}}}}}}, "then": {"properties": {"conclusions": {"properties": {"consistency_conclusion_allowed": {"const": false}}}}}},
    {"if": {"properties": {"freeze": {"properties": {"attachment_manifest": {"properties": {"frozen": {"const": false}}}}}}}, "then": {"properties": {"conclusions": {"properties": {"consistency_conclusion_allowed": {"const": false}}}}}},
    {"if": {"properties": {"freeze": {"properties": {"pagination": {"properties": {"frozen": {"const": false}}}}}}}, "then": {"properties": {"conclusions": {"properties": {"consistency_conclusion_allowed": {"const": false}}}}}},
    {"if": {"properties": {"freeze": {"properties": {"execution_status": {"properties": {"frozen": {"const": false}}}}}}}, "then": {"properties": {"conclusions": {"properties": {"consistency_conclusion_allowed": {"const": false}}}}}}
  ]
}
